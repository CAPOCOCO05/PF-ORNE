# Copia este archivo como .env y llena los valores de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key>

# URL de la API de ORNE (backend/). Para probar en el celular usa la IP de tu PC
# en la misma red Wi-Fi (ipconfig en Windows), no localhost
EXPO_PUBLIC_API_URL=http://<IP-de-tu-PC>:3000
