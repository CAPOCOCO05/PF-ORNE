# Copia este archivo como .env y llena los valores de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API). Son los mismos que usa el frontend.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=<tu-anon-key>

# Puerto de la API. El celular la encuentra en http://<IP-de-tu-PC>:PORT
PORT=3000
